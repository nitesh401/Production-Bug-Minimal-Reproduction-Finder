<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.example.reproduction</groupId>
  <artifactId>production-reproduction-finder</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Production Bug Minimal Reproduction Finder</name>

  <properties>
    <java.version>21</java.version>
    <testcontainers.version>1.20.3</testcontainers.version>
  </properties>

  <modules>
    <module>common</module>
    <module>reproduction-persistence</module>
    <module>reproduction-platform</module>
    <module>reproduction-simulator-service</module>
    <module>reproduction-analysis-service</module>
    <module>reproduction-worker-service</module>
    <module>reproduction-orchestrator-service</module>
    <module>reproduction-api-service</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.example.reproduction</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.reproduction</groupId>
        <artifactId>reproduction-persistence</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.reproduction</groupId>
        <artifactId>reproduction-platform</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
